* .ac oct 100 10 100
.tran 0 3 0 0.1m uic
.options plotwinsize=0
.save V(out22) V(out28)
.param Avol_val = 100k
.param GBW_val = 4meg
.param Slew_val = 13meg
.param Ilimit_val = 10m
.param Rail_val = 0
.param Vos_val = 0
.param Phimargin_val = 56
.param En_val = 0
.param Enk_val = 0
.param In_val = 0
.param Ink_val = 0
.param Rin_val = 1T
.param Ro_val = 150
.param Ccm_val = 0
.param Cdiff_val = 0
.param C_val = 2.2n
.param R1_val = 15k
.param R2_val = 100
.param R3_val = 18k
.param R4_val = 7.15k
.param R5_val = 10
.param R6_val = 10.2k
* All-passive Monte Carlo: independently varies GIC-R, GIC-C, Rc, G_n, and beta_n; one fixed board per sample
.param passive_tol = 0.01
.param all_passive_sample = 1
.param GIC_R_tol = passive_tol
.param GIC_C_tol = passive_tol
.param Rc_tol = passive_tol
.param Rn_linear_tol = passive_tol
.param Rn_nonlinear_tol = passive_tol
.param Rn_beta_val = 2e-4
.func GICR(nom,id) {nom*(1+GIC_R_tol*(2*rand(10000*all_passive_sample+id)-1))}
.func GICC(nom,id) {nom*(1+GIC_C_tol*(2*rand(10000*all_passive_sample+1000+id)-1))}
.func RCVAR(nom,id) {nom*(1+Rc_tol*(2*rand(10000*all_passive_sample+2000+id)-1))}
.func RNLINVAR(nom,id) {nom*(1+Rn_linear_tol*(2*rand(10000*all_passive_sample+3000+id)-1))}
.func RNNLVAR(nom,id) {nom*(1+Rn_nonlinear_tol*(2*rand(10000*all_passive_sample+4000+id)-1))}
.param Rc1_val = 137497
